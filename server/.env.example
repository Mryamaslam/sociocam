# Copy this file to .env and fill in real values. Never commit the real .env file.

# Required in production — the server refuses to start without one (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — defaults to 4000.
PORT=4000

# Optional — restrict which origins may call this server. Defaults to "*" (any origin),
# which is fine for local dev but should be set to your actual client URL in production,
# e.g. https://your-app.example.com
CORS_ORIGIN=*

# Set to "production" to enable production-only checks (e.g. JWT_SECRET is required).
NODE_ENV=development
